PORT=4000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/repradar
MONGO_URI_TEST=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/repradar-test
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
# Optional: how close (metres) to the saved gym a check-in must be. Default 150.
CHECKIN_RADIUS_M=150
